<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!-- Unidad de persistencia usada por Main: Persistence.createEntityManagerFactory("institutoPU") -->
    <persistence-unit name="institutoPU" transaction-type="RESOURCE_LOCAL">

        <!-- Entidades gestionadas -->
        <class>com.example.instituto.model.Alumno</class>
        <class>com.example.instituto.model.Ciclo</class>
        <class>com.example.instituto.model.Curso</class>
        <class>com.example.instituto.model.Matricula</class>
        <class>com.example.instituto.model.Modulo</class>

        <properties>
            <!-- Conexión (propiedades estándar JPA) -->
            <property name="jakarta.persistence.jdbc.driver" value="org.sqlite.JDBC"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:sqlite:instituto.db"/>

            <!-- Generación del esquema (estándar JPA): create, drop-and-create, update... -->
            <property name="jakarta.persistence.schema-generation.database.action" value="update"/>

            <!-- Única propiedad propia de Hibernate: mostrar el SQL que se ejecuta -->
            <property name="hibernate.show_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
